#!/usr/bin/env python3
import shutil
import sys

arguments = sys.argv[1:]
destination = arguments[-1]
sources = arguments[:-1]

failed = []
for source in sources:
    try:
        shutil.copytree(source, destination)
    except FileNotFoundError:
        failed.append(source)

print("These paths failed to copy:")
for failing in failed:
    print(f"\t{failing}")
